<Window x:Class="BarShift.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BarShift - Paramètres" Width="960" Height="900"
        MinWidth="900" MinHeight="800"
        WindowStartupLocation="CenterScreen"
        Background="#12121F" Foreground="White" FontSize="13">

    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AAB0C8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#2A2A45"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1E1E30"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="BorderBrush" Value="#3A3A5C"/>
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,0,22,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#1A1A2C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3A3A5C"/>
            <Setter Property="Padding" Value="4"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Paramètres de BarShift"
                   FontSize="22" FontWeight="Bold" Margin="0,0,0,16"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Liste des barres (on peut y déposer une application) -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="Mes barres"
                           FontWeight="SemiBold" Margin="0,0,0,6"/>
                <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Button Content="Ajouter" Click="AddBar_Click" Margin="0,0,6,6"/>
                    <Button Content="Supprimer" Click="DeleteBar_Click" Margin="0,0,6,6"/>
                    <Button Content="▲" ToolTip="Monter" Click="BarUp_Click" Margin="0,0,6,6"/>
                    <Button Content="▼" ToolTip="Descendre" Click="BarDown_Click" Margin="0,0,6,6"/>
                </WrapPanel>
                <ListBox x:Name="BarsList" AllowDrop="True"
                         SelectionChanged="BarsList_SelectionChanged"
                         DragOver="BarsList_DragOver" Drop="BarsList_Drop"/>
            </DockPanel>

            <!-- Détails de la barre sélectionnée -->
            <Grid x:Name="DetailsPanel" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="190"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource Label}" Text="Nom de la barre"/>
                        <TextBox x:Name="NameBox" TextChanged="NameBox_TextChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource Label}" Text="Couleur (clique sur le carré)"/>
                        <DockPanel>
                            <Border x:Name="ColorSwatch" DockPanel.Dock="Right" Width="30"
                                    Margin="6,0,0,0" CornerRadius="4" Background="#1E1E30"
                                    BorderBrush="#3A3A5C" BorderThickness="1"
                                    Cursor="Hand" ToolTip="Choisir une couleur"
                                    MouseLeftButtonUp="ColorSwatch_MouseLeftButtonUp"/>
                            <TextBox x:Name="ColorBox" TextChanged="ColorBox_TextChanged"/>
                        </DockPanel>

                        <Popup x:Name="ColorPopup"
                               PlacementTarget="{Binding ElementName=ColorSwatch}"
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                            <Border Background="#1E1E30" BorderBrush="#3A3A5C" BorderThickness="1"
                                    CornerRadius="8" Padding="10" Margin="0,6,0,0">
                                <WrapPanel x:Name="PalettePanel" Width="312"/>
                            </Border>
                        </Popup>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Style="{StaticResource Label}" Text="Raccourci de la barre"/>
                        <TextBox x:Name="HotkeyBox" IsReadOnly="True"
                                 ToolTip="Clique ici puis appuie sur ta combinaison (Suppr pour effacer)"
                                 PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                 TextChanged="HotkeyBox_TextChanged"/>
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Row="1"
                           Text="Applications de la barre (glisse une application sur une autre barre pour la déplacer, Ctrl pour la copier)"
                           FontWeight="SemiBold" Margin="0,0,0,6" TextWrapping="Wrap"/>

                <ListBox Grid.Row="2" x:Name="AppsList" AllowDrop="True"
                         SelectionChanged="AppsList_SelectionChanged"
                         PreviewMouseLeftButtonDown="AppsList_PreviewMouseLeftButtonDown"
                         PreviewMouseMove="AppsList_PreviewMouseMove"
                         DragOver="AppsList_DragOver" Drop="AppsList_Drop"/>

                <WrapPanel Grid.Row="3" Margin="0,8,0,12">
                    <Button Content="Ajouter une application…" Click="AddApp_Click"/>
                    <Button Content="Supprimer" Click="DeleteApp_Click"/>
                    <Button Content="▲" ToolTip="Monter" Click="AppUp_Click"/>
                    <Button Content="▼" ToolTip="Descendre" Click="AppDown_Click"/>
                </WrapPanel>

                <Border Grid.Row="4" Background="#1A1A2C" CornerRadius="8" Padding="14">
                    <Grid x:Name="AppDetailsPanel">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Nom"
                                   VerticalAlignment="Center" Foreground="#AAB0C8"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                                 x:Name="AppNameBox" Margin="0,0,0,8"
                                 TextChanged="AppNameBox_TextChanged"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Chemin"
                                   VerticalAlignment="Center" Foreground="#AAB0C8"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="AppPathBox"
                                 IsReadOnly="True" Margin="0,0,8,8"/>
                        <Button Grid.Row="1" Grid.Column="2" Content="Parcourir…"
                                Margin="0,0,0,8" Click="BrowseApp_Click"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Icône"
                                   VerticalAlignment="Center" Foreground="#AAB0C8"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                    Orientation="Horizontal">
                            <Image x:Name="AppIconPreview" Width="32" Height="32" Margin="0,0,12,0"/>
                            <Button Content="Choisir une icône…" Click="ChooseIcon_Click"/>
                            <Button Content="Icône par défaut" Click="ResetIcon_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Éléments Windows affichés dans la barre -->
        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock Text="Éléments Windows affichés dans la barre"
                       FontWeight="SemiBold" Margin="0,0,0,8"/>
            <WrapPanel>
                <CheckBox x:Name="ChkStart" Content="Bouton Démarrer"/>
                <CheckBox x:Name="ChkSearch" Content="Recherche"/>
                <CheckBox x:Name="ChkTaskView" Content="Vue des tâches"/>
                <CheckBox x:Name="ChkWifi" Content="Wi-Fi / réseau"/>
                <CheckBox x:Name="ChkVolume" Content="Volume"/>
                <CheckBox x:Name="ChkBattery" Content="Batterie"/>
                <CheckBox x:Name="ChkClock" Content="Heure et date"/>
                <CheckBox x:Name="ChkDesktop" Content="Afficher le bureau"/>
            </WrapPanel>

            <CheckBox x:Name="ChkHideTaskbar" Margin="0,6,0,0"
                      Content="Masquer la barre des tâches Windows (BarShift la remplace)"/>

            <CheckBox x:Name="ChkFullscreen" Margin="0,10,0,0"
                      Content="Masquer BarShift quand une application est en plein écran (jeux, vidéos)"/>

            <CheckBox x:Name="ChkAutoStart" Margin="0,10,0,0"
                      Content="Lancer BarShift au démarrage de Windows"/>
        </StackPanel>

        <!-- Raccourcis globaux pour changer rapidement de barre -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,14,0,0">
            <StackPanel Margin="0,0,24,0">
                <TextBlock Style="{StaticResource Label}" Text="Barre suivante (raccourci global)"/>
                <TextBox x:Name="NextHotkeyBox" Width="230" IsReadOnly="True"
                         ToolTip="Clique ici puis appuie sur ta combinaison (Suppr pour effacer)"
                         PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Style="{StaticResource Label}" Text="Barre précédente (raccourci global)"/>
                <TextBox x:Name="PrevHotkeyBox" Width="230" IsReadOnly="True"
                         ToolTip="Clique ici puis appuie sur ta combinaison (Suppr pour effacer)"
                         PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button Content="Annuler" Click="Cancel_Click"/>
            <Button Content="Enregistrer" Background="#3B82F6" Margin="0" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
